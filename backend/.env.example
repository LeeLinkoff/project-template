# =============================================================================================
# Environment Configuration
#
# Copy this file to .env and update the values for the application being built.
#
# IMPORTANT:
#   - Do not commit the real .env file.
#   - Do not store passwords, API keys, or other secrets in source control.
# =============================================================================================

# ---------------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------------

# Port used by the backend HTTP server.
PORT=3002

# Application environment.
NODE_ENV=development


# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------

# PostgreSQL connection string.
#
# Format:
# postgresql://<username>:<password>@<host>:<port>/<database>
#
# Template database:
# postgresql://example_app:exampleUserPassword@localhost:5432/exampledb
#
# IMPORTANT:
# Replace the example credentials/database with values appropriate for the application and environment.
DATABASE_URL=postgresql://example_app:exampleUserPassword@localhost:5432/exampledb


# ---------------------------------------------------------------------------------------------
# Optional Application-Specific Configuration
# ---------------------------------------------------------------------------------------------

# Add project-specific environment variables below as the application evolves.
#
# Examples:
#
# EXTERNAL_API_URL=
# EXTERNAL_API_KEY=
# FEATURE_FLAG_NAME=